# ---------------------------------------------------------------------------
# Vanshavali environment variables.
#
# Copy this file to `.env` (which is gitignored) and fill in the values you
# need for your environment. See CONTRIBUTING.md §1 for the full setup guide.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Environment switch — THE single backend selector. Drives both the app and the
# db:* / stack:* CLI tooling.
#
#   "local" — Local Supabase stack via `supabase start` (real Postgres + Auth +
#             Storage + Realtime in Docker). URL/keys default automatically, so
#             none of the Supabase vars below are needed. Same provider code as
#             prod, so local dev exercises the exact path prod does.
#   "prod"  — Your cloud Supabase project. Fill the Supabase vars below.
#
# Unset defaults to "prod" (cloud). See docs/SUPABASE-SETUP.md.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENV=local

# Optional overrides for the local stack, only if `npm run stack:status` prints
# values different from the built-in defaults (127.0.0.1:54321 + demo keys):
# NEXT_PUBLIC_SUPABASE_URL_LOCAL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY_LOCAL=
# SUPABASE_SERVICE_ROLE_KEY_LOCAL=

# ---------------------------------------------------------------------------
# Cloud Supabase configuration — required when NEXT_PUBLIC_ENV=prod.
# Find these in your Supabase project: Settings → API.
# (Ignored when NEXT_PUBLIC_ENV=local — the local stack's values are built in.)
# ---------------------------------------------------------------------------

# Public URL of your Supabase project, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (public) key. Safe to expose to the browser — RLS policies are what
# actually gate access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. NEVER expose this to the browser; only used by server
# routes (e.g. /api/invite/send) that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for the CLOUD project. Used by the
# db:apply-policies / db:setup scripts when NEXT_PUBLIC_ENV=prod (local uses the
# stack's postgres:postgres@127.0.0.1:54322 automatically). Supabase: Settings →
# Database → Connection string → URI; replace [YOUR-PASSWORD].
DATABASE_URL=

# ---------------------------------------------------------------------------
# Transactional email — required when invitations land (Phase 10).
# ---------------------------------------------------------------------------

# Resend API key — https://resend.com
RESEND_API_KEY=

# Sender address shown on invite emails. Must be a verified Resend domain.
RESEND_FROM_EMAIL=

# Public site URL used to build invite-acceptance links in outbound email.
# Defaults to the incoming request's origin when unset, which works in dev;
# set explicitly in production so emails always link to the canonical host.
NEXT_PUBLIC_SITE_URL=
