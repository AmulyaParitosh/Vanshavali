# ---------------------------------------------------------------------------
# Vanshavali environment variables.
#
# Copy this file to `.env` (which is gitignored) and fill in the values you
# need for your environment. See CONTRIBUTING.md §1 for the full setup guide.
# ---------------------------------------------------------------------------

# Backend selector.
#   "local"     — file-backed mock providers under .local_data/. No network.
#   "supabase"  — Supabase (Postgres + Auth + Storage). Real backend.
#   "firebase"  — legacy; will be removed.
# If unset and Supabase env vars are present, defaults to "supabase";
# otherwise defaults to "firebase".
NEXT_PUBLIC_APP_ENV=local

# Forces a specific mock user in local mode (otherwise defaults to
# "local-admin-uid"). Only consulted when NEXT_PUBLIC_APP_ENV=local.
NEXT_PUBLIC_LOCAL_USER_UID=local-admin-uid

# ---------------------------------------------------------------------------
# Supabase configuration — required when NEXT_PUBLIC_APP_ENV=supabase.
# Find these in your Supabase project: Settings → API.
# ---------------------------------------------------------------------------

# Public URL of your Supabase project, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (public) key. Safe to expose to the browser — RLS policies are what
# actually gate access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. NEVER expose this to the browser; only used by server
# routes (e.g. /api/invite/send) that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. Used by Drizzle Kit for schema
# migrations (npm run db:push). Find this in Supabase: Settings → Database →
# Connection string → URI. Replace [YOUR-PASSWORD] with your DB password.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Transactional email — required when invitations land (Phase 10).
# ---------------------------------------------------------------------------

# Resend API key — https://resend.com
RESEND_API_KEY=

# Sender address shown on invite emails. Must be a verified Resend domain.
RESEND_FROM_EMAIL=

# Public site URL used to build invite-acceptance links in outbound email.
# Defaults to the incoming request's origin when unset, which works in dev;
# set explicitly in production so emails always link to the canonical host.
NEXT_PUBLIC_SITE_URL=
