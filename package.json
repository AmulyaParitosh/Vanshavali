{
  "name": "vanshavali",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:diff": "supabase db diff -f",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:extras": "tsx scripts/setup-extras.ts",
    "stack:start": "supabase start",
    "stack:stop": "supabase stop",
    "stack:status": "supabase status",
    "stack:reset": "supabase stop --no-backup && supabase start",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,md,css,sql}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "family-tree",
    "genealogy",
    "nextjs",
    "supabase"
  ],
  "author": "Amulya Paritosh",
  "license": "MIT",
  "description": "Multi-tenant family tree app — Madhubani-inspired visualization on Next.js + Supabase.",
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "d3": "^7.9.0",
    "nanoid": "^5.1.11",
    "next": "^15.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/ui": "^4.1.9",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "pg": "^8.21.0",
    "prettier": "^3.8.4",
    "supabase": "^2.110.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
